# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# SUPABASE_URL: URL of your Supabase project.
VITE_SUPABASE_URL="MY_SUPABASE_URL"

# SUPABASE_ANON_KEY: Public API key for your Supabase project.
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# GOOGLE_ANALYTICS: Optional Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID="G-B0FEPOZUCI"
